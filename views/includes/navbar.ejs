<style>
.search-btn {
  background-color: #fe424d;
  color: #fff;
  border-radius: 25px;
  padding: 0 1rem;
}
.search-btn:hover {
  background-color: #fe424d;
  color: #fff;
}
.search-btn i {
  display: inline;
  margin-right: 0.5rem;
}
.search-inp {
  border-radius: 25px;
  padding: 0.5rem 1rem;
  font-size: 1rem;
  width: 250px;
}

/*Mobile View*/
@media (max-width: 991px) {
  .navbar.sticky-top {
    position: static;
  }

  .navbar-collapse {
    background-color: white;
    padding: 10px 0 20px 0;
  }

  .navbar-nav {
    width: 100%;
  }

  .navbar form {
    width: 100%;
  }

   .search-inp {
    width: 100%;
  }

  .search-btn {
    margin-top: 0.5rem;
    width: 100%;
  }

  .navbar .navbar-nav:last-child {
    margin-top: 0.5rem;
  }
}
</style>

<nav class="navbar navbar-expand-lg bg-body-light border-bottom sticky-top">
    <div class="container-fluid">

      <!--logo-->
      <a class="navbar-brand" href="/listings"><i class="fa-solid fa-compass"></i></a>
      <button 
      class="navbar-toggler" 
      type="button" 
      data-bs-toggle="collapse" 
      data-bs-target="#navbarNavAltMarkup" 
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
       >
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

        <!--Explore-->
        <div class="navbar-nav">
          <a class="nav-link" href="/listings">Explore</a>
        </div>
         <div class="navbar-nav mx-lg-auto">
           <form class="d-flex flex-column flex-lg-row my-2 my-lg-0" role="search" action="/listings" method="GET">
      <input class="form-control me-lg-2 search-inp" type="search" name="search" placeholder="Search destinations"  required />
      <button class="btn search-btn" type="submit">
       <i class="fa-solid fa-magnifying-glass"></i>Search</button>
    </form>
         </div>
        <div class="navbar-nav ">
          <a class="nav-link" href="/listings/new">Stayora your home</a>
          <% if(!currUser) { %>
          <a class="nav-link"  href="/signup"><b>Sign Up</b></a>
          <a class="nav-link" href="/login"><b>Log in </b></a>
           <% } %> <% if(currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
         <% } %>
        </div>
      </div>
    </div>
  </nav>